# For local Cloudflare runtime copy these keys to ignored .dev.vars.
# Production: configure through Sites as server-side runtime secrets/values.
PRODUCTION_READY=false
PUBLIC_SITE_URL=http://localhost:3000
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
QONSUL_COCKPIT_INTAKE_URL=https://cockpit.qonsul.de
# First-party analytics stays inactive until the website consent layer activates it.
NEXT_PUBLIC_QONSUL_ANALYTICS_ENDPOINT=
QONSUL_COCKPIT_INTAKE_SECRET=
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_RETENTION_DAYS=90
RATE_LIMIT_SALT=
MAINTENANCE_SECRET=
PUBLIC_CONTACT_EMAIL=
LEGAL_ENTITY_NAME=
LEGAL_ADDRESS=
LEGAL_REPRESENTATIVE=
LEGAL_PHONE=
LEGAL_REGISTER=
LEGAL_VAT_ID=
LEGAL_EDITORIAL_RESPONSIBLE=
LEGAL_DISPUTE_RESOLUTION=
