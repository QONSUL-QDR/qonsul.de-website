{
  "name": "qonsul-quality-engineering",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "typecheck": "tsc --noEmit",
    "setup:local": "node scripts/setup-local.mjs",
    "test": "node scripts/check-repository.mjs && node scripts/check-analysis.mjs && node scripts/check-ishikawa-pdf.mjs",
    "test:integration": "node scripts/test-local.mjs",
    "check:repository": "node scripts/check-repository.mjs",
    "test:api": "node scripts/check-api.mjs",
    "test:pdf": "node scripts/check-ishikawa-pdf.mjs",
    "pdf:sample": "node scripts/create-pdf-sample.mjs"
  },
  "dependencies": {
    "next": "16.2.6",
    "react": "19.2.8",
    "react-dom": "19.2.6",
    "drizzle-orm": "0.45.2"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@openai/sites-vite-plugin": "^0.1.0 || ^0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.3",
    "vite": "8.0.13",
    "wrangler": "4.92.0",
    "drizzle-kit": "0.31.10"
  },
  "type": "module"
}
