{
  "name": "qonsul-quality-engineering",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "typecheck": "tsc --noEmit",
    "setup:local": "node scripts/setup-local.mjs",
    "test": "node scripts/check-repository.mjs && node scripts/check-production-artifact-workflow.mjs && node scripts/check-production-deployment-workflow.mjs && node scripts/check-production-legal-preview.mjs && node scripts/check-production-regressions.mjs && node scripts/check-restored-staging-baseline.mjs && node scripts/check-diagnostic-contract.mjs && node scripts/check-ai-polling.mjs && node scripts/check-consultation-correction-storage.mjs && node scripts/check-analysis.mjs && node scripts/check-ishikawa-pdf.mjs",
    "test:integration": "node scripts/test-local.mjs",
    "test:production-legal": "node scripts/check-production-legal-build.mjs",
    "check:repository": "node scripts/check-repository.mjs",
    "test:api": "node scripts/check-api.mjs",
    "test:pdf": "node scripts/check-ishikawa-pdf.mjs",
    "pdf:sample": "node scripts/create-pdf-sample.mjs",
    "check:production-artifact-workflow": "node scripts/check-production-artifact-workflow.mjs",
    "check:production-deployment-workflow": "node scripts/check-production-deployment-workflow.mjs",
    "release:verify-candidate": "node scripts/verify-production-candidate.mjs",
    "release:seal-artifact": "node scripts/seal-production-artifact.mjs"
  },
  "dependencies": {
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "drizzle-orm": "0.45.2"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.62.3",
    "@cloudflare/workers-types": "5.20261001.1",
    "@openai/sites-vite-plugin": "^0.1.0 || ^0.2.0",
"@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.1",
    "@vitejs/plugin-rsc": "0.5.35",
    "eslint": "10.11.0",
    "eslint-config-next": "16.3.8",
    "react-server-dom-webpack": "19.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vinext": "1.0.0",
    "vite": "8.3.1",
    "wrangler": "4.145.0",
    "drizzle-kit": "0.31.11"
  },
  "type": "module"
}
